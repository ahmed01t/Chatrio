# ==============================================================================
# Chatrio — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
APP_NAME="Chatrio API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# -----------------------------------
# 2. CORS Settings (Allowed Frontends)
# -----------------------------------
# Comma-separated list of URLs that are allowed to make requests to this backend.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# -------------------------------------------------------
# 3. Database Connection (PostgreSQL with asyncpg driver)
# -------------------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/chatrio_db"

# -----------------------------------------------------------
# 4. Redis Connection (for BullMQ Queues and Debounce Buffer)
# -----------------------------------------------------------
# Format: redis://<host>:<port>/<db_index>
REDIS_URL="redis://localhost:6379/0"

# 5. Security & Authentication (JWT Tokens)
# Secret key used to sign and verify digital keycard tokens (JWTs).
# In production, this must be a long, randomly generated string!
JWT_SECRET="dev-super-secret-jwt-key-change-this-in-production-min-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 6. Meta WhatsApp Cloud API Settings
# ------------------------------------------------------------------------------
META_APP_SECRET="dev-meta-app-secret-placeholder"
META_VERIFY_TOKEN="chatrio-webhook-verify-token-dev"
META_ACCESS_TOKEN="EAAG_dev_placeholder_access_token"
META_PHONE_NUMBER_ID="100000000000000"
META_API_VERSION="v21.0"

# ------------------------------------------------------------------------------
# 7. WhatsApp Debounce Settings (Sliding Inactivity Window)
# ------------------------------------------------------------------------------
WHATSAPP_DEBOUNCE_SECONDS=2.5
WHATSAPP_DEBOUNCE_MAX_WAIT_SECONDS=8.0

# ------------------------------------------------------------------------------
# 8. AI Agent & LangGraph Orchestration
# ------------------------------------------------------------------------------
# Provider: groq, grok, gemini, openai, ollama, or custom
AI_PROVIDER="groq"
AI_API_KEY=""
AI_API_BASE=""
AI_MODEL_NAME="llama-3.3-70b-versatile"
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=500
AI_SYSTEM_NAME="Chatrio Assistant"

# Legacy/fallback
OPENAI_API_KEY=""

