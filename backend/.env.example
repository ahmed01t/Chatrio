# ==============================================================================
# Chatrio — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
APP_NAME="Chatrio API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# -----------------------------------
# 2. CORS Settings (Allowed Frontends)
# -----------------------------------
# Comma-separated list of URLs that are allowed to make requests to this backend.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# -------------------------------------------------------
# 3. Database Connection (PostgreSQL with asyncpg driver)
# -------------------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/chatrio_db"

# -----------------------------------------------------------
# 4. Redis Connection (for BullMQ Queues and Debounce Buffer)
# -----------------------------------------------------------
# Format: redis://<host>:<port>/<db_index>
REDIS_URL="redis://localhost:6379/0"

# 5. Security & Authentication (JWT Tokens)
# Secret key used to sign and verify digital keycard tokens (JWTs).
# In production, this must be a long, randomly generated string!
JWT_SECRET="dev-super-secret-jwt-key-change-this-in-production-min-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60





